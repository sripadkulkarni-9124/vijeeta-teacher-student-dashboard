// Security rules for the named Firestore database `vijeeta-dashboard`.
//
// This database has no client. The dashboard server reaches Firestore through
// the Firebase Admin SDK under the Cloud Run runtime service account, and Admin
// SDK access bypasses security rules entirely, so nothing here constrains the
// application. The browser ships no Firestore SDK, holds no Firestore
// credential, and must never be given one; see the forbidden-changes list in
// docs/deploy-vijeeta-dashboard.md.
//
// These rules are therefore a defence-in-depth backstop, not the authorization
// model. Authorization lives in the server route handlers and the store. The
// only correct rule set for this database is deny-all: if a Firebase ID token
// for this project were ever pointed at this database from a browser, an
// extension, or a leaked client config, every read and write must fail.
//
// Any future client access requires a separate security review that covers the
// per-collection authorization policy, the redaction contract, and the indexes
// it would need. Do not relax a path here to unblock a feature.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Every document in every collection, at every depth: no client read, no
    // client write, for any credential, authenticated or not.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
